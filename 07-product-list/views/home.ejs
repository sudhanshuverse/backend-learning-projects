<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
    <link href="/output.css" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <h1 class="text-3xl font-bold text-gray-800 mb-6">Product Manager </h1>
        <!-- Form Card -->
        <div class="bg-white shadow-md rounded-lg p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4">Add Product</h2>
            <form action="/submit" method="POST" class="space-y-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
                    <input type="text" name="name" id="name" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
                <div>
                    <label for="price" class="block text-sm font-medium text-gray-700">Price</label>
                    <input type="number" name="price" id="price" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700">Description</label>
                    <input type="text" name="description" id="description" required class="w-full mt-1 p-2 border rounded-md focus:ring-2 focus:ring-blue-500 outline-none">
                </div>

                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition">Submit </button>
            </form>
        </div>

        <!-- Products List -->
        <div>
            <h2 class="text-xl font-semibold mb-4">All Products</h2>
            <div class="grid md:grid-cols-2 gap-4">
                <% products.forEach(product => { %>
                    <div class="bg-white shadow rounded-lg p-4">
                        <h3 class="text-lg font-bold text-gray-800"><%= product.name %></h3>
                        <p class="text-gray-600 mt-1"> &#8377;<%= product.price %></p>
                        <p class="text-gray-500 mt-1"><%= product.description %></p>
                        <a href="/delete/<%= product._id %>" class="inline-block mt-3 text-red-500 hover:underline"> Delete</a>
                    </div>
                <% }) %>
            </div>
        </div>

    </div>

</body>
</html>