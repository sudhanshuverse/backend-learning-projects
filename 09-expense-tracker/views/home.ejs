<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense Tracker</title>
    <!-- Tailwind Output CSS -->
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-gray-100 font-sans">

    <header class="bg-indigo-600 text-white text-center py-5 text-2xl font-bold shadow">Expense Tracker 💰</header>
    <div class="max-w-xl mx-auto mt-10 bg-white p-6 rounded-lg shadow">
        <h2 class="text-xl font-semibold mb-4">Add Expense</h2>
        <form action="/submit" method="POST" class="flex flex-col gap-3">
            <div>
                <label class="block font-medium">Title</label>
                <input type="text" name="title" required class="w-full mt-1 p-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-400">
            </div>
            <div>
                <label class="block font-medium">Amount</label>
                <input type="number" name="amount" required class="w-full mt-1 p-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-400">
            </div>
            <div>
                <label class="block font-medium">Date</label>
                <input type="date" name="date" required class="w-full mt-1 p-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-400">
            </div>
            <button type="submit" class="mt-3 bg-indigo-600 text-white py-2 rounded hover:bg-indigo-700 transition"> Add Expense</button>
        </form>

        <h2 class="text-xl font-semibold mt-8 mb-4">All Expenses</h2>
        <ul class="space-y-3">
            <% expenses.forEach(expense => { %>
                <li class="flex justify-between items-center bg-gray-50 p-3 rounded">
                    <div>
                        <p class="font-semibold text-xl"><%= expense.title %></p>
                        <p class="text-gray-600 text-lg">₹ <%= expense.amount %></p>
                        <p class="text-gray-400 text-base"><%= expense.date %></p>
                    </div>
                    <a href="/delete/<%= expense._id %>" class="bg-red-500 text-white px-3 py-1 rounded text-sm hover:bg-red-600"> Delete</a>
                </li>
            <% }) %>
        </ul>
    </div>

</body>
</html>