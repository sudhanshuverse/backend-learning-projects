{
  "name": "01-simple-notes-app",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "server": "nodemon app.js",
    "tailwind": "tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "browser": "browser-sync start --proxy \"localhost:8000\" --files \"views/**/*.ejs, public/**/*.css\"",
    "start": "concurrently \"npm run server\" \"npm run tailwind\" \"npm run browser\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "mongoose": "^9.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.2.1"
  }
}
