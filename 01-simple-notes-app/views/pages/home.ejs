<!-- HEADING -->
<%- include('../partials/head') %>

    </head>
    <body class="bg-gray-100 min-h-screen flex items-center justify-center">
        <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-lg">
            <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Notes App</h1>
            <form action="/form-data" method="POST" class="space-y-5">
                <div>
                    <label for="heading" class="block text-sm font-medium text-gray-700 mb-1">Heading</label>
                    <input type="text" name="heading" id="heading" placeholder="Enter note title" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="paragraph" class="block text-sm font-medium text-gray-700 mb-1">Paragraph</label>
                    <textarea name="paragraph" id="paragraph" rows="4" placeholder="Enter your notes" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-md font-semibold hover:bg-blue-700 transition">Save Note</button>
            </form>

            <h1 class="mt-10 text-2xl">Show data</h1>
            <div class="mt-6 space-y-4">
                <% notes.forEach(note=> { %>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 shadow-sm">
                        <h2 class="text-lg font-semibold text-gray-800"><%= note.heading %></h2>
                        <p class="text-gray-600 mt-2"><%= note.paragraph %></p>
                        <a href="/delete/<%= note._id %>" class="bg-red-600 text-white p-2 mt-3 inline-block rounded">Delete</a>
                    </div>
                <% }) %>
            </div>
        </div>
        </div>

    </body>
    </html>