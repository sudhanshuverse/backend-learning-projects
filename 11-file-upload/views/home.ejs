<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload App</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-100 min-h-screen">
    <div class="max-w-5xl mx-auto p-6">
        <h1 class="text-3xl font-bold text-center mb-8 text-gray-800">File Upload Dashboard</h1>
        <div class="bg-white p-6 rounded-2xl shadow-md mb-10">
            <h2 class="text-xl font-semibold mb-4 text-gray-700">Upload Image</h2>
            <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                <input type="file" name="file" required class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition"> Upload File </button>
            </form>
        </div>

        <!-- Gallery Section -->
        <h2 class="text-2xl font-semibold mb-4 text-gray-800">Uploaded Files</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            <% allData.forEach(file=> { %>
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
                    <img src="/<%= file.filepath %>" alt="<%= file.filename %>" class="w-full h-48 object-cover" onerror="this.src='https://via.placeholder.com/300x200?text=File'">
                    <div class="p-4">
                        <p class="text-sm text-gray-600 truncate"><%= file.filename %></p>
                        <div class="flex justify-between items-center mt-3">
                            <a href="/<%= file.filepath %>" target="_blank" class="text-blue-600 text-sm hover:underline"> View</a>
                            <form action="/delete/<%= file._id %>" method="POST">
                                <button type="submit" class="text-red-500 text-sm hover:underline" onclick="return confirm('Are you sure you want to delete this file?')"> Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        <!-- Empty State -->
        <% if (allData.length===0) { %>
            <p class="text-center text-gray-500 mt-10">No files uploaded yet </p>
        <% } %>
    </div>

</body>
</html>