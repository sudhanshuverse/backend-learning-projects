<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog App</title>
    <link rel="stylesheet" href="./output.css">
</head>
<body class="bg-gradient-to-br from-gray-100 to-gray-200 min-h-screen">
    <div class="max-w-4xl mx-auto p-6">
        <h1 class="text-4xl font-extrabold text-center text-gray-800 mb-10 tracking-tight"> Blog App</h1>
        <div class="bg-white shadow-xl rounded-2xl p-8 mb-8 border border-gray-100">
            <h2 class="text-2xl font-semibold mb-6 text-gray-700">Create New Blog</h2>
            <form action="/submit" method="POST" class="space-y-5">
                <div>
                    <label class="block text-gray-600 mb-2 text-sm font-medium">Title</label>
                    <input type="text" name="title" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
                </div>
                <div>
                    <label class="block text-gray-600 mb-2 text-sm font-medium">Content</label>
                    <textarea name="content" rows="4" required class="w-full  px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none transition resize-none"  ></textarea>
                </div>
                <button type="submit"class="w-full bg-blue-500 text-white py-2.5 rounded-lg font-medium hover:bg-blue-600 active:scale-95 transition transform">Publish Blog
                </button>
            </form>
        </div>

        <!-- Blog List -->
        <div class="bg-white shadow-xl rounded-2xl p-8 border border-gray-100">
            <h2 class="text-2xl font-semibold mb-6 text-gray-700">All Blogs</h2>
            <% blogs.forEach(data => { %>
                <div class="bg-gray-50 hover:bg-gray-100 transition rounded-xl p-5 mb-4 shadow-sm">
                    <h3 class="text-xl font-semibold text-gray-800"><%= data.title %></h3>
                    <p class="text-gray-600 mt-2 leading-relaxed"><%= data.content %> </p>
                    <a href="/delete/<%= data._id %>" class="block mt-4 w-full text-center bg-red-500 text-white py-2 rounded-lg hover:bg-red-600 transition">🗑 Delete</a>
                </div>
            <% }) %>
        </div>
    </div>

</body>
</html>