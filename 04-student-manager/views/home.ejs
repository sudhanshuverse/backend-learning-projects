<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Manager</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-5">

    <h1 class="text-3xl font-bold text-center mb-6"> Student Management</h1>
    <!-- FORM -->
    <div class="max-w-md mx-auto bg-white p-5 rounded-xl shadow-md mb-8">
        <h2 class="text-xl font-semibold mb-4">Add Student</h2>
        <form action="/submit" method="POST" class="space-y-3">
            <input type="text" name="name" placeholder="Name" class="w-full border p-2 rounded" required>
            <input type="text" name="course" placeholder="Course"class="w-full border p-2 rounded" required>
            <input type="text" name="roll" placeholder="Roll Number"class="w-full border p-2 rounded" required>
            <button type="submit" class="w-full bg-blue-500 text-white p-2 rounded hover:bg-blue-600"> Submit
            </button>
        </form>
    </div>

    <!-- STUDENT CARDS -->
    <h2 class="text-2xl font-semibold mb-4 text-center">Student List</h2>
    <div class="max-w-[1400px] mx-auto grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        <% if (students.length === 0) { %>
            <p>No students found</p>
        <% } %>
        <% students.forEach(student => { %>
            <div class="bg-white p-4 rounded-xl shadow-md hover:shadow-lg transition">
                <h3 class="text-lg font-bold text-blue-600"><%= student.name %></h3>
                <p class="text-gray-600"> Course: <%= student.course %></p>
                <p class="text-gray-600"> Roll: <%= student.roll %></p>
                <div class="mt-4 flex justify-between">
                    <a href="/delete/<%= student._id %>" class="text-red-500 hover:underline"> Delete</a>
                </div>
            </div>
        <% }) %>
    </div>

</body>
</html>