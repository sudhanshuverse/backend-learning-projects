<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feedback Page</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col items-center">

    <div class="w-full max-w-3xl px-4 py-8">
        <h1 class="flex items-center justify-center gap-3 text-2xl sm:text-3xl font-bold text-gray-800 mb-8">
            <img src="/assets/feedback.svg" alt="feedback icon" class="w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 object-contain">
            <span>Feedback Page</span>
        </h1>

        <!-- Form Card -->
        <div class="bg-white shadow-md rounded-xl p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Leave Feedback</h2>
            <form action="/submit" method="POST" class="space-y-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-600">Name</label>
                    <input type="text" name="name" id="name" placeholder="Enter your name" class="w-full mt-1 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required>
                </div>
                <div>
                    <label for="message" class="block text-sm font-medium text-gray-600">Message</label>
                    <textarea name="message" id="message" rows="3" placeholder="Write your feedback..." class="w-full mt-1 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required></textarea>
                </div>
                <button type="submit" class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition"> Submit Feedback</button>
            </form>
        </div>

        <!-- Feedback List -->
        <div class="bg-white shadow-md rounded-xl p-6">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">All Feedback</h2>
            <div class="space-y-4">
                <% feedbacks.forEach(data=> { %>
                    <div class="border rounded-lg p-4 flex justify-between items-start">
                        <div>
                            <p class="font-semibold text-gray-800"><%= data.name %></p>
                            <p class="text-gray-600 text-sm mt-1"><%= data.message %></p>
                        </div>
                        <a href="/delete/<%= data._id %>" class="text-red-500 text-sm hover:underline">Delete</a>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

</body>

</html>