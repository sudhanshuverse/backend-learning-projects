<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Manager</title>
    <link rel="stylesheet" href="./output.css">
</head>
<body class="bg-gray-100 min-h-screen">
    <!-- Header -->
    <div class="bg-blue-600 text-white p-4 text-center text-2xl font-bold shadow">
        📇 Contact Manager
    </div>
    <div class="max-w-6xl mx-auto p-4">
        <!-- Form Card -->
        <div class="bg-white p-6 rounded-xl shadow-md mb-6">
            <h2 class="text-xl font-semibold mb-4">Add New Contact</h2>
            <form action="/submit" method="POST" class="grid gap-4 md:grid-cols-3">
                <input type="text" name="name" placeholder="Name"class="border p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"required>
                <input type="text" name="number" placeholder="Number"class="border p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"required>
                <input type="email" name="email" placeholder="Email (optional)"class="border p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                <button type="submit"class="md:col-span-3 bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">Add Contact</button>
            </form>
        </div>

        <!-- Contacts Grid -->
        <h2 class="text-xl font-semibold mb-4">All Contacts</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% contacts.forEach(contact => { %>
                <div class="bg-white p-4 rounded-xl shadow hover:shadow-lg transition">
                    <h3 class="text-lg font-bold text-gray-800 mb-2"><%= contact.name %></h3>
                    <p class="text-gray-600">&#9742; <%= contact.number %></p>
                    <% if(contact.email) { %>
                        <p class="text-gray-600">&#x2709; <%= contact.email %></p>
                    <% } %>
                    <div class="mt-4 flex justify-between items-center">
                        <a href="/delete/<%= contact._id %>" class="text-red-500 hover:text-red-700 font-semibold">Delete</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

</body>
</html>